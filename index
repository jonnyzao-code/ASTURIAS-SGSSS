                    </div>
                    <div class="chart-item">
                        <span class="label">Redes Insuficientes</span>
                        <div class="bar-bg"><div class="bar-fill red" style="width:30%;"></div></div>
                        <span class="value">30%</span>
                    </div>
                    <p style="font-size:0.7rem; color:#64748b; margin-top:10px;">Fuente: Supersalud (2023), Informe de Gestión.</p>
                </div>
